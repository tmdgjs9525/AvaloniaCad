<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="AvaloniaCad.Editor.Controls.EditorToolbar"
    x:DataType="vm:EditorViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:AvaloniaCad.Editor.ViewModels"
    xmlns:tools="clr-namespace:AvaloniaCad.Editor.Tools"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <!--  RadioButton을 토글 버튼 모양으로 표시 (같은 GroupName 안에서 하나만 선택됨)  -->
        <Style Selector="RadioButton.tool">
            <Setter Property="Theme" Value="{StaticResource {x:Type ToggleButton}}" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Height" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="ToggleButton.option">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Height" Value="32" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <StackPanel>

        <!--  메뉴  -->
        <Menu>
            <MenuItem Header="_File">
                <MenuItem Header="_New" InputGesture="Ctrl+N" />
                <MenuItem Header="_Open..." InputGesture="Ctrl+O" />
                <Separator />
                <MenuItem Header="_Save" InputGesture="Ctrl+S" />
                <MenuItem Header="Save _As..." InputGesture="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="_Export PNG..." />
                <Separator />
                <MenuItem Header="E_xit" InputGesture="Alt+F4" />
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGesture="Ctrl+Z" />
                <MenuItem Header="_Redo" InputGesture="Ctrl+Y" />
                <Separator />
                <MenuItem Header="_Copy" InputGesture="Ctrl+C" />
                <MenuItem Header="_Delete" InputGesture="Delete" />
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="_Fit to Content" InputGesture="Ctrl+0" />
                <MenuItem
                    Header="Show _Grid"
                    IsChecked="True"
                    ToggleType="CheckBox" />
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="_About" />
            </MenuItem>
        </Menu>

        <!--  도구 모음  -->
        <Border
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,1,0,1"
            Padding="6,4">

            <StackPanel Orientation="Horizontal" Spacing="4">

                <RadioButton Classes="tool" GroupName="DrawingTool"
                             Content="Select" IsChecked="True"
                             Command="{Binding SelectToolCommand}"
                             CommandParameter="{x:Static tools:ToolKind.Select}"
                             ToolTip.Tip="선택 (V)"/>
                <RadioButton Classes="tool" GroupName="DrawingTool"
                             Content="Line"
                             Command="{Binding SelectToolCommand}"
                             CommandParameter="{x:Static tools:ToolKind.Line}"
                             ToolTip.Tip="선 (L)"/>
                <RadioButton Classes="tool" GroupName="DrawingTool"
                             Content="Rect"
                             Command="{Binding SelectToolCommand}"
                             CommandParameter="{x:Static tools:ToolKind.Rectangle}"
                             ToolTip.Tip="사각형 (R)"/>
                <RadioButton Classes="tool" GroupName="DrawingTool"
                             Content="Circle"
                             Command="{Binding SelectToolCommand}"
                             CommandParameter="{x:Static tools:ToolKind.Circle}"
                             ToolTip.Tip="원 (C)"/>
                <RadioButton Classes="tool" GroupName="DrawingTool"
                             Content="Polyline"
                             Command="{Binding SelectToolCommand}"
                             CommandParameter="{x:Static tools:ToolKind.Polyline}"
                             ToolTip.Tip="폴리라인 (P)"/>
                <RadioButton Classes="tool" GroupName="DrawingTool"
                             Content="Pan"
                             Command="{Binding SelectToolCommand}"
                             CommandParameter="{x:Static tools:ToolKind.Pan}"
                             ToolTip.Tip="화면 이동 (H)"/>

                <!--  구분선  -->
                <Border
                    Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    Margin="6,4"
                    Width="1" />

                <ToggleButton Classes="option" 
                              Content="Snap" 
                              IsChecked="{Binding SnapEnabled}"
                              ToolTip.Tip="스냅 켜기/끄기 (F3)"/>

            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
