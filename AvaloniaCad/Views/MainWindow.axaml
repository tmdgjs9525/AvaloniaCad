<Window
    Icon="/Assets/avalonia-logo.ico"
    Title="AvaloniaCad"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="AvaloniaCad.Views.MainWindow"
    x:DataType="vm:MainViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:RegionNames="clr-namespace:AvaloniaCad.Core;assembly=AvaloniaCad.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:region="using:Avalonia.Container.Region"
    xmlns:views="clr-namespace:AvaloniaCad.Editor.Views;assembly=AvaloniaCad.Editor"
    xmlns:vm="using:AvaloniaCad.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Design.DataContext>
        <!--
            This only sets the DataContext for the previewer in an IDE,
            to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs)
        -->
        <vm:MainViewModel />
    </Design.DataContext>

    <ContentControl region:RegionManager.RegionName="{x:Static RegionNames:RegionNames.MainRegion}" />

</Window>
